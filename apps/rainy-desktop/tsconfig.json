{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2024",
      "DOM"
    ],
    "paths": {
      "@deepseek-ai/dsh-client-ui-rainy/native-tools-protocol": [
        "../../packages/client/ui-rainy/src/native-tools-protocol.ts"
      ],
      "@deepseek-ai/dsh-client-ui-rainy/ide-files-protocol": [
        "../../packages/client/ui-rainy/src/ide-files-protocol.ts"
      ],
      "@deepseek-ai/dsh-client-ui-rainy/ide-execution-protocol": [
        "../../packages/client/ui-rainy/src/ide-execution-protocol.ts"
      ],
      "@deepseek-ai/dsh-client-ui-rainy/runtime-protocol": [
        "../../packages/client/ui-rainy/src/runtime-protocol.ts"
      ],
      "@deepseek-ai/dsh-client-ui-rainy/strata-protocol": [
        "../../packages/client/ui-rainy/src/strata-protocol.ts"
      ],
      "@deepseek-ai/dsh-client-ui-rainy/modules-protocol": [
        "../../packages/client/ui-rainy/src/modules-protocol.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/build.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "src/editor-assets"
  ]
}
